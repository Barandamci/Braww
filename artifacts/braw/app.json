{
  "expo": {
    "name": "Braw",
    "slug": "braw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "braw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6DFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.braw.tr"
    },
    "android": {
      "package": "com.braw.tr",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A6DFF"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Braw profiliniz için fotoğraf seçmenize izin verin.",
          "cameraPermission": "Braw fotoğraf çekmenize izin verin."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1A6DFF",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Braw Bildirimleri"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
